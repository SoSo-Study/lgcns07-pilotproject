# 이 파일을 복사해서 .env.local 을 만들고 값을 채워요. (.env.local 은 절대 커밋하지 않기)
# 진짜 값은 팀 비공개 채팅방에서만 주고받아요.

# 강사님 API 서버 주소 (테스트 서버). NEXT_PUBLIC_을 붙이지 않아요 — 서버에서만 읽어서 브라우저로 안 나가요
API_URL=

# 테스트 서버의 시연용 인증번호를 화면에 보여 줄지 (발표 · 시험용: true, 실서비스: 비워 두기)
SHOW_DEMO_CODE=

# 로그인(NextAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
